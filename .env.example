# Environment Variables Template
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# ===================================
# Supabase Configuration
# ===================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Your Supabase project ID
VITE_SUPABASE_PROJECT_ID="your-project-id"

# Your Supabase project URL
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# Your Supabase anon/public key (safe to use in client-side code)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# ===================================
# FastAPI Backend
# ===================================
# URL to your FastAPI backend (for VAPI outbound phone calls)
VITE_BACKEND_URL="http://localhost:8000"

# ===================================
# Development Notes
# ===================================
# - All variables must start with VITE_ to be exposed to the client
# - Restart your dev server after changing environment variables
# - Never commit .env file to git (it's in .gitignore)
# - Use .env.example as a template for team members
# - VAPI credentials are now in backend/.env (server-side only)
